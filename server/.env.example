# Copy to .env for local runs. Never commit .env.
DATABASE_URL=postgresql://qatys:qatys@localhost:5432/qatys
# At least 32 characters. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
# Firebase service account key JSON on ONE line. Empty = pushes are only logged.
FCM_SERVICE_ACCOUNT_JSON=
# Tests only:
TEST_DATABASE_URL=postgresql://qatys:qatys@localhost:5432/qatys_test
